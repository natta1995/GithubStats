@page "/"
@rendermode InteractiveServer
@using global::GithubStats.Models
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>GitHub Stats</PageTitle>

<h1>GitHub Stats</h1>

<div class="mb-3">
    <label for="username">GitHub-användarnamn:</label>
    <input id="username" @bind="username" class="form-control" />
</div>

<button class="btn btn-primary" @onclick="SearchUser">Hämta statistik</button>

@if (isLoading)
{
    <p class="mt-3">Hämtar data...</p>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <p class="text-danger mt-3">@error</p>
}

@if (user != null)
{
    <div class="mt-4">
        <img src="@user.avatar_url" alt="Avatar" width="100" class="mb-3" />

        <h3>@user.name (@user.login)</h3>

        @if (!string.IsNullOrWhiteSpace(user.bio))
        {
            <p>@user.bio</p>
        }

        <p>Publika repos: @user.public_repos</p>
        <p>Followers: @user.followers</p>
        <p>Following: @user.following</p>
    </div>
}

@if (repos is not null && repos.Any())
{
    <div class="mt-4">
        <h3>Repos</h3>

        <ul>
            @foreach (var repo in repos)
            {
                <li class="mb-2">
                    <strong>@repo.name</strong>
                    @if (!string.IsNullOrWhiteSpace(repo.language))
                    {
                        <span> - @repo.language</span>
                    }
                    <span> - ⭐ @repo.stargazers_count</span>
                </li>
            }
        </ul>
    </div>
}

@code {
    private string username = "";
    private GitHubUser? user;
    private List<GitHubRepo> repos = new();
    private string error = "";
    private bool isLoading = false;

    private async Task SearchUser()
    {
        if (string.IsNullOrWhiteSpace(username))
        {
            error = "Skriv in ett GitHub-användarnamn.";
            user = null;
            repos.Clear();
            return;
        }

        isLoading = true;
        error = "";
        user = null;
        repos.Clear();

        try
        {
            Http.DefaultRequestHeaders.UserAgent.ParseAdd("GithubStatsApp");

            user = await Http.GetFromJsonAsync<GitHubUser>(
                $"https://api.github.com/users/{username}");

            var repoResult = await Http.GetFromJsonAsync<List<GitHubRepo>>(
                $"https://api.github.com/users/{username}/repos");

            if (repoResult is not null)
            {
                repos = repoResult
                    .OrderByDescending(r => r.stargazers_count)
                    .ToList();
            }
        }
        catch
        {
            error = "Kunde inte hämta data från GitHub.";
        }
        finally
        {
            isLoading = false;
        }
    }
}